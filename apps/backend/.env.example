GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_APPLICATION_CREDENTIALS=./credentials/service-account.json
GCS_BUCKET_NAME=applyai-files
FIRESTORE_COLLECTION=applyai_sessions
GEMINI_API_KEY=your-gemini-api-key
LlamaIndex_API_KEY=your-llamaindex-api-key
ALLOWED_ORIGINS=http://localhost:3000

# Firebase Auth — service account from GOOGLE_APPLICATION_CREDENTIALS is reused by default.
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CREDENTIALS_PATH=
# Set to "1" for local dev only — accepts "Bearer dev:<uid>" tokens, bypassing Firebase verification.
AUTH_DEV_BYPASS=

# LangSmith — optional agent tracing. Leave LANGSMITH_TRACING blank to disable.
LANGSMITH_TRACING=
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=ApplyAi
