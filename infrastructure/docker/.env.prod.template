# Production env for docker-compose.prod.yml. Fill in real values; keep on the
# VPS only (gitignored). Used for both ${VAR} interpolation and backend env_file.

# Traefik / TLS
ACME_EMAIL=you@example.com

# Public domains (A-records -> VPS IP)
FRONTEND_DOMAIN=applyai.robinkphilip.com
BACKEND_DOMAIN=applyai-backend.robinkphilip.com

# Frontend build args (NEXT_PUBLIC_API_URL is derived in compose)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Backend runtime (ALLOWED_ORIGINS + GOOGLE_APPLICATION_CREDENTIALS set in compose)
GOOGLE_CLOUD_PROJECT=
GCS_BUCKET_NAME=
FIRESTORE_COLLECTION=applyai_sessions
GEMINI_API_KEY=
LLAMAINDEX_API_KEY=
FIREBASE_PROJECT_ID=
FIREBASE_CREDENTIALS_PATH=
AUTH_DEV_BYPASS=

# LangSmith tracing (optional)
LANGSMITH_TRACING=
LANGSMITH_ENDPOINT=
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=
